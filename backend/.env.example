# Local dev (SQLite) — leave as-is if running locally
# DATABASE_URL=sqlite:///./data/app.db

# Production (Supabase Postgres). Use the "Direct connection" or "Session pooler"
# string from Supabase → Project Settings → Database. e.g.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# For the session pooler (IPv4, pooled), use port 5432 with the pooler host;
# the direct connection uses port 5432 on db.<ref>.supabase.co.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Comma-separated list of allowed browser origins (your Vercel app URL).
CORS_ORIGINS=https://your-app.vercel.app

# Bearer token required by editing endpoints. Set the same value in the
# frontend as VITE_PLANNER_TOKEN. Not a real auth system — pilot only.
PLANNER_TOKEN=dev-token
